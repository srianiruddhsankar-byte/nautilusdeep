# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys (URL is under Data API / project overview)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Push notifications (Phase 10b). The PUBLIC half of the VAPID key pair from
# `npx web-push generate-vapid-keys`. The private half goes ONLY in Supabase
# (Edge Functions → Secrets → VAPID_PRIVATE_KEY), never here or in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
